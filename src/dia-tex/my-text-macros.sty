% NOTE For zero-argument text macros like the following, it is
% advisable to append an empty group `{}` in order
% to ensure correct spacing.

% Auxiliary macro for the interletter space
\newcommand*{\spatium}{\kern 0.1em\relax}

% Macros for abbreviations without interior dots
\newcommand*{\bzw}{bzw.}
\newcommand*{\usw}{usw.}
\newcommand*{\vs}{vs.}
\newcommand*{\viz}{viz.}

% Macros for abbreviations with interior dots
\newcommand*{\aka}{a.{\spatium}k.{\spatium}a.}
\newcommand*{\as}{a.{\spatium}s.}
\newcommand*{\BSc}{B.{\spatium}Sc.}
% % `\dh` is already defined by `fontenc` with T1 option.
% \newcommand*{\dh}{d.{\spatium}h.}
\newcommand*{\eg}{e.{\spatium}g.}
\newcommand*{\fue}{f.{\spatium}ü.}
\newcommand*{\iA}{i.{\spatium}A.}
\newcommand*{\ie}{i.{\spatium}e.}
\newcommand*{\io}{i.{\spatium}o.}
\newcommand*{\iV}{i.{\spatium}V.}
\newcommand*{\loccit}{loc.{\spatium}cit.}
\newcommand*{\maW}{m.{\spatium}a.{\spatium}W}
\newcommand*{\MSc}{M.{\spatium}Sc.}
\newcommand*{\NN}{N.{\spatium}N.}
\newcommand*{\oae}{o.{\spatium}ä.}
\newcommand*{\opcit}{op.{\spatium}cit.}
\newcommand*{\PhD}{Ph.{\spatium}D.}
\newcommand*{\ProfDr}{Prof.{\spatium}Dr.}
\newcommand*{\PS}{p.{\spatium}s.}
\newcommand*{\RIP}{R.{\spatium}I.{\spatium}P.}
