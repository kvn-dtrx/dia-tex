% ---

% Shortcuts for textual delimiters

% Semantic inline source code.  Keep the presentation here rather than at
% call sites so that generated and handwritten documents use the same style.
\DeclareRobustCommand{\code}[1]{\texttt{#1}}

\newcommand*{\quoting}[1]{\textquotedblright#1\textquotedblleft}
\newcommand*{\colloquial}[1]{\textquotedblright#1\textquotedblleft}
\newcommand*{\gravename}[1]{{\normalfont\scshape#1}}
\newcommand*{\overstating}[1]{\textquotedblright#1\textquotedblleft}

% ---

% Amounts of money

\@ifpackageloaded{numprint}{
    \nprounddigits{2}
}{%
    \PackageWarning{my-text-macros}{Package numprint not loaded. \string\numprint will be a no-op}%
    \newcommand{\numprint}[1]{%
        \@namedef{#1}%
    }%
}

\newcommand*{\DOLLAR}[1]{\numprint{#1}~{\scshape\lowercase{DOL}}}
\newcommand*{\EURO}[1]{\numprint{#1}~{\scshape\lowercase{EUR}}}

% ---

% Date-related

\@ifpackageloaded{datetime2}{}{%
    \PackageWarning{my-text-macros}{Package datetime2 not loaded. \string\DTMdisplaydate will be a no-op}%
    \newcommand{\DTMdisplaydate}[4]{%
        \@namedef{#1}{#2}{#3}{#4}%
    }%
}

\newcommand*{\dateprint}[3]{%
    \DTMdisplaydate{#1}{#2}{#3}{-1}%
}

\newcommand*{\born}[3]{%
    *\dateprint{#1}{#2}{#3}%
}
