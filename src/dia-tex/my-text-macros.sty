\NeedsTeXFormat{LaTeX2e}

\ProvidesPackage{my-text-macros}[%
    1970/01/01 v0.0-dev My text-related user-level macros.%
]

% ---

% NOTE For zero-argument text macros like the following, it is
% advisable to append an empty group `{}` in order
% to ensure correct spacing.

% Auxiliary macro for the interletter space
\newcommand*{\spatium}{\kern 0.1em\relax}

% Preserves the customary empty group and absorbs a duplicate sentence point
\newcommand*{\my@abbreviation}[1]{%
    #1%
    \futurelet\my@abbreviation@next\my@abbreviation@group
}

\newcommand*{\my@abbreviation@group}{%
\ifx\my@abbreviation@next\bgroup
    \expandafter\@firstoftwo
\else
    \expandafter\@secondoftwo
\fi
{\my@abbreviation@consume@group}%
{\my@abbreviation@period}%
}

\newcommand*{\my@abbreviation@consume@group}[1]{%
    #1%
    \my@abbreviation@period
}

\newcommand*{\my@abbreviation@period}{%
    \futurelet\my@abbreviation@next\my@abbreviation@period@check
}

\newcommand*{\my@abbreviation@period@check}{%
\ifx\my@abbreviation@next.%
    \expandafter\@firstoftwo
\else
    \expandafter\@secondoftwo
\fi
{\my@abbreviation@gobble@period}%
{\@}%
}

\newcommand*{\my@abbreviation@gobble@period}[1]{}

