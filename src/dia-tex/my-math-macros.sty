% Miscellaneous

% A visual more appealing quotient
% Compare with:
% [A symbol for the quotient of two objects](https://tex.stackexchange.com/questions/4624)
\newcommand*{\quot}[2]{\mathchoice%
    {\left.\raisebox{.2em}{\ensuremath{#1}}\middle/\raisebox{-.2em}{\ensuremath{#2}}\right.}%
    {#1 / #2}
    {#1 / #2}
    {#1 / #2}
}

